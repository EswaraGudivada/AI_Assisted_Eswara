{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=urlshortener.db"
  },
  "Database": {
    "AutoMigrate": true
  },
  "OpenApi": {
    "Enabled": false
  },
  "Shortener": {
    "BaseUrl": "http://localhost:5080",
    "CodeLength": 7,
    "MaxGenerationAttempts": 3,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "MaxUrlLength": 2048,
    "DeduplicateUrls": true
  },
  "Security": {
    "AllowPrivateNetworkTargets": false,
    "DeniedHosts": []
  },
  "Cache": {
    "LinkTtlSeconds": 300,
    "MissingTtlSeconds": 30,
    "SizeLimit": 10000
  },
  "Analytics": {
    "QueueCapacity": 10000,
    "BatchSize": 200,
    "MaxStatsRangeDays": 366,
    "DefaultStatsWindowDays": 30,
    "TopReferrerCount": 10
  },
  "RateLimit": {
    "ResolutionsPerMinutePerIp": 600,
    "WritesPerMinutePerIp": 30,
    "QueueLimit": 0
  }
}
