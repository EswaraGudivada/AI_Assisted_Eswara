{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Shortener": {
    "BaseUrl": "",
    "CodeLength": 7,
    "MaxGenerationAttempts": 5,
    "DeduplicateUrls": true,
    "MaxUrlLength": 2048,
    "MaxStatsWindowDays": 90,
    "BlockedHosts": []
  },
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=urlshortener.db"
  },
  "Caching": {
    "Enabled": true,
    "TtlSeconds": 60,
    "MaxEntries": 10000
  },
  "ClickTracking": {
    "QueueCapacity": 10000,
    "BatchSize": 100
  },
  "RateLimiting": {
    "CreatePermitsPerMinute": 30,
    "RedirectPermitsPerMinute": 600
  }
}
